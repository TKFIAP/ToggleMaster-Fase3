# Modelo do Secret do ToggleMaster.
# Como usar: copie este arquivo para "secrets.yaml" (que fica fora do Git
# pelo .gitignore), troque os valores entre aspas pelos reais e rode:
#   kubectl apply -f k8s/secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: togglemaster-secrets
  namespace: togglemaster
type: Opaque
stringData:
  # Bancos PostgreSQL no RDS (um por servico)
  AUTH_DATABASE_URL: "postgres://USUARIO:SENHA@ENDPOINT-DO-AUTH-DB:5432/auth_db"
  FLAG_DATABASE_URL: "postgres://USUARIO:SENHA@ENDPOINT-DO-FLAG-DB:5432/flags_db"
  TARGETING_DATABASE_URL: "postgres://USUARIO:SENHA@ENDPOINT-DO-TARGETING-DB:5432/targeting_db"

  # Redis no ElastiCache (usado pelo evaluation-service)
  REDIS_URL: "redis://ENDPOINT-DO-REDIS:6379"

  # Chave mestra definida por voces para o auth-service (usada no /admin/keys)
  MASTER_KEY: "COLOQUE_AQUI_A_MASTER_KEY"

  # Chave gerada pelo endpoint /admin/keys (usada pelo evaluation-service)
  SERVICE_API_KEY: "COLOQUE_AQUI_A_CHAVE_GERADA"

 